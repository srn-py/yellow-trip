# deploy/Caddyfile.local
# For rehearsing the production stack on your own computer.
# Certificates come from Caddy's own private authority, so the browser shows a warning you must accept once.
# Use the address with your HTTPS_PORT, for example https://localhost:8443 and https://airflow.localhost:8443
{
	local_certs
	auto_https disable_redirects
}

(security) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(ops_auth) {
	basic_auth {
		{$OPS_USER} {$OPS_PASSWORD_HASH}
	}
}

localhost {
	import security
	import ops_auth
	reverse_proxy dashboard:8501
}

airflow.localhost {
	import security
	import ops_auth
	reverse_proxy airflow:8080
}

grafana.localhost {
	import security
	reverse_proxy grafana:3000
}

ingest.localhost {
	import security
	import ops_auth
	request_body {
		max_size 2GB
	}
	reverse_proxy ingestion:8000
}
