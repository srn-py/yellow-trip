# .env.example
# ----------------------------------------------------------------------------
# Template for your local settings. Run `make init` (or copy this file to
# `.env`) and edit the copy. `.env` is git-ignored so secrets never get committed.
# ----------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Ports on YOUR machine (change if a port is already taken) ---------------
INGESTION_PORT=8000
OBJECTSTORE_API_PORT=9000
OBJECTSTORE_CONSOLE_PORT=9001

# --- Object storage / data lake (used from Milestone 1) ----------------------
# MinIO's official images were removed in Sept 2026; Silo is a drop-in fork.
OBJECTSTORE_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z
S3_ENDPOINT_URL=http://objectstore:9000
S3_ACCESS_KEY=platform_admin
S3_SECRET_KEY=change-me-please-123
S3_REGION=us-east-1
BUCKET_RAW=raw
BUCKET_CLEAN=clean
BUCKET_QUARANTINE=quarantine

# --- Data sources and ingestion (used from Milestone 1) ----------------------
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
TLC_ZONE_LOOKUP_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv
DOWNLOAD_MAX_RETRIES=3
DROPZONE_DIR=/data/dropzone
DROPZONE_POLL_SECONDS=10
REGISTRY_DB_PATH=/data/registry/registry.db

# --- Explorer / JupyterLab (Milestone 2) ---
JUPYTER_PORT=8888
JUPYTER_TOKEN=taxi

# --- Cleaning service (Milestone 3) ---
CLEANING_PORT=8100
INGESTION_URL=http://ingestion:8000
DUCKDB_MEMORY_LIMIT=2GB
MAX_TRIP_DISTANCE_MILES=100
MAX_TRIP_HOURS=24
MAX_SPEED_MPH=100
MAX_PASSENGERS=6

# --- Warehouse and ETL service (Milestone 4) ---
WAREHOUSE_PORT=5433
ETL_PORT=8200
POSTGRES_HOST=warehouse
POSTGRES_PORT=5432
POSTGRES_DB=taxi_dw
POSTGRES_USER=taxi
POSTGRES_PASSWORD=change-me-too-456
CLEANING_URL=http://cleaning:8000
DBT_PROJECT_DIR=/app/dbt
DBT_TIMEOUT_SECONDS=3600

# --- Airflow orchestration (Milestone 5) ---
AIRFLOW_PORT=8180
AIRFLOW_IMAGE=apache/airflow:3.3.2
AIRFLOW_DB_PASSWORD=change-me-airflow-789
AIRFLOW_JWT_SECRET=change-me-change-me-change-me-change-me-change-me-change-me-1234
ETL_URL=http://etl:8000
PIPELINE_MONTH_LAG=2

# --- Analytics API and dashboard (Milestone 6) ---
ANALYTICS_PORT=8300
DASHBOARD_PORT=8501
ANALYTICS_URL=http://analytics:8000

# --- Observability (Milestone 7) ---
QUALITY_PORT=8400
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me-grafana-123
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
GRAFANA_IMAGE=grafana/grafana:13.2.3
LOG_FORMAT=text
QUALITY_INTERVAL_SECONDS=300
QUALITY_STARTUP_DELAY_SECONDS=45
QUALITY_MAX_LOAD_AGE_DAYS=45
QUALITY_ROWCOUNT_TOLERANCE_PCT=40
QUALITY_MAX_QUARANTINE_PCT=10
QUALITY_MAX_DBT_AGE_DAYS=45