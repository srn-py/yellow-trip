# .env.prod.example
# Template for .env.prod. DO NOT put real secrets in this file; it is committed to Git.
# Create the real file, with strong random secrets, using:
#   python scripts/make_prod_env.py --domain taxi.example.com --email you@example.com --owner your-github-name
#   python scripts/make_prod_env.py --local        (a rehearsal on your own computer)

# --- Where it lives ------------------------------------------------------------------
SITE_DOMAIN=taxi.example.com
ACME_EMAIL=you@example.com
CADDYFILE=Caddyfile
HTTP_PORT=80
HTTPS_PORT=443

# --- Which version to run ---------------------------------------------------------------
GHCR_OWNER=your-github-name
IMAGE_TAG=latest

# --- Behaviour ----------------------------------------------------------------------------
LOG_LEVEL=INFO
PIPELINE_MONTH_LAG=2
DUCKDB_MEMORY_LIMIT=2GB
QUALITY_INTERVAL_SECONDS=300

# --- Secrets (generated) ------------------------------------------------------------------------
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
POSTGRES_DB=taxi_dw
POSTGRES_USER=taxi
POSTGRES_PASSWORD=CHANGE_ME
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=https://grafana.taxi.example.com

# The login for the dashboard, Airflow and the ingest API (a bcrypt hash, never the password itself).
# Single quotes are required: the hash contains $ characters.
OPS_USER=ops
OPS_PASSWORD_HASH='CHANGE_ME'

# --- Alerts: any URL that accepts a JSON POST (leave empty to disable) ----------------------------
ALERT_WEBHOOK_URL=